{
  "manifest_version": 3,
  "name": "Reverse Vertical Tab Placement",
  "description": "Places new tabs at the top, while keeping child tabs next to their opener and inside the opener's tab group.",
  "version": "1.1.0",
  "minimum_chrome_version": "109",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Reverse Vertical Tab Placement",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "clipboardWrite",
    "contextMenus",
    "offscreen",
    "storage",
    "tabs",
    "tabGroups",
    "webNavigation"
  ],
  "commands": {
    "new-tab-at-top": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Option+Shift+T"
      },
      "description": "Open a new tab at the top of the unpinned tab section"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "service_worker.js"
  }
}
